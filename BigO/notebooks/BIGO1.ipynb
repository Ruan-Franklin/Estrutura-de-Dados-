   "source": [
    "# Notação Big O\n",
    "\n",
    "## Função 1 - O(N)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5865d020",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "347 ns ± 33.2 ns per loop (mean ± std. dev. of 7 runs, 1,000,000 loops each)\n"
     ]
    }
   ],
   "source": [
    "def soma1(n):\n",
    "    soma = 0 \n",
    "    for i in range(n + 1):\n",
    "        soma += i\n",
    "    return soma\n",
    "\n",
    "soma1(10)\n",
    "%timeit soma1(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d94fa0ed",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "55"
      ]
     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "def soma2(n):\n",
    "    return (n* (n+ 1)) // 2\n",
    "\n",
    "\n",
    "soma2(10)\n"
   ]
  },
  {
   "cell_type": "code",
